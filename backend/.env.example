# ---------- Serveur ----------
PORT=4000

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3308
DB_USER=root
DB_PASSWORD=
DB_NAME=info_collect

# ---------- Collecteur ----------
# Site source
SOURCE_BASE_URL=https://www.goafricaonline.com
# Pause entre deux requêtes (ms) : rester respectueux du site
REQUEST_DELAY_MS=1500
# Délai maximum d'attente d'une page (ms)
REQUEST_TIMEOUT_MS=15000
# Nombre maximum de pages de liste parcourues par secteur
MAX_LISTING_PAGES=5
# Nombre maximum de fiches entreprises ouvertes par recherche
MAX_COMPANIES=20
# Nombre maximum de secteurs utilisés pour un mot-clé
MAX_CATEGORIES=2
# Respecter le fichier robots.txt du site (recommandé : true)
RESPECT_ROBOTS_TXT=true
# Identité envoyée au site
USER_AGENT=Mozilla/5.0 (compatible; GoAfricaCollectorPOC/1.0; projet de stage)

# ---------- Cache ----------
# Une même recherche n'est pas recollectée pendant N jours (lue depuis la base)
CACHE_DAYS=7

# ---------- Optionnel ----------
# URL de la recherche par nom du site source, si identifiée (F12 > Réseau).
# {country} et {query} sont remplacés automatiquement. Laisser vide si inconnue.
# Exemple (à vérifier) : https://www.goafricaonline.com/{country}/recherche?q={query}
SEARCH_URL_TEMPLATE=
